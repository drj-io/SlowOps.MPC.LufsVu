  // Syntax: cream text, amber keywords, brass types, red constants
  "editor.tokenColorCustomizations": {
    "comments": "#7a7488",
    "keywords": "#ffb347",
    "strings": "#e8c98a",
    "numbers": "#ff6b7a",
    "types": "#f0d08c",
    "functions": "#ffd27f",
    "variables": "#f1e2bd",
    "textMateRules": [
      {
        "scope": ["comment", "punctuation.definition.comment"],
        "settings": { "fontStyle": "italic", "foreground": "#7a7488" }
      },
      {
        "scope": ["keyword.control", "storage.type", "storage.modifier", "keyword.other"],
        "settings": { "foreground": "#ffb347", "fontStyle": "bold" }
      },
      {
        "scope": ["keyword.operator"],
        "settings": { "foreground": "#e3b265" }
      },
      {
        "scope": ["constant.language", "constant.numeric", "variable.other.enummember", "constant.other"],
        "settings": { "foreground": "#ff6b7a" }
      },
      {
        "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "support.type", "storage.type.built-in"],
        "settings": { "foreground": "#f0d08c" }
      },
      {
        "scope": ["entity.name.function", "support.function"],
        "settings": { "foreground": "#ffd27f" }
      },
      {
        "scope": ["keyword.control.directive", "meta.preprocessor", "punctuation.definition.directive"],
        "settings": { "foreground": "#e07a9a" }
      },
      {
        "scope": ["variable.parameter"],
        "settings": { "foreground": "#c8bfe8", "fontStyle": "italic" }
      },
      {
        "scope": ["variable.other.member", "variable.other.property"],
        "settings": { "foreground": "#e9c99a" }
      },
      {
        "scope": ["string", "string.quoted"],
        "settings": { "foreground": "#e8c98a" }
      },
      {
        "scope": ["constant.character.escape"],
        "settings": { "foreground": "#ff3b4e" }
      }
    ]
  }
}
