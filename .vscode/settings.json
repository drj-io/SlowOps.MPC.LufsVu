{
  // ── "Studio VU" workspace theme ────────────────────────────────────────
  // Midnight-navy panels, walnut + brass trim, cream dial text,
  // amber "active" buttons and neon-red clip/bypass accents.
  "workbench.colorTheme": "Default Dark Modern",
  "window.titleBarStyle": "custom",

  "workbench.colorCustomizations": {
    // Base surfaces (midnight navy)
    "foreground": "#e9d9b4",
