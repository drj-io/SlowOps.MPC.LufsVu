    "menu.border": "#e0283a88",

    // Git decorations
    "gitDecoration.modifiedResourceForeground": "#ffb347",
    "gitDecoration.untrackedResourceForeground": "#d9c47a",
    "gitDecoration.addedResourceForeground": "#d9c47a",
    "gitDecoration.deletedResourceForeground": "#ff3b4e",
    "gitDecoration.ignoredResourceForeground": "#5a5670",
    "gitDecoration.conflictingResourceForeground": "#ff6b7a"
