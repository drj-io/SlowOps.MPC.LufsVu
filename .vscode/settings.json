    "terminal.ansiMagenta": "#e07a9a",
    "terminal.ansiCyan": "#9ec8c0",
    "terminal.ansiWhite": "#f1e2bd",
    "terminal.ansiBrightBlack": "#5a5670",
    "terminal.ansiBrightRed": "#ff6b7a",
    "terminal.ansiBrightGreen": "#e0de8a",
    "terminal.ansiBrightYellow": "#ffd27f",
    "terminal.ansiBrightBlue": "#b4c0f5",
    "terminal.ansiBrightMagenta": "#f5a0bc",
    "terminal.ansiBrightCyan": "#c0e6de",
    "terminal.ansiBrightWhite": "#fff6e0",

    // Status bar (brass rail with red bypass when debugging)
    "statusBar.background": "#3a1a10",
    "statusBar.foreground": "#ffc46b",
    "statusBar.border": "#ff3b4e88",
    "statusBar.noFolderBackground": "#1d1f2c",
    "statusBar.debuggingBackground": "#c41f30",
    "statusBar.debuggingForeground": "#fff0e0",
    "statusBarItem.hoverBackground": "#5b2616",
    "statusBarItem.remoteBackground": "#e0283a",
    "statusBarItem.remoteForeground": "#ffffff",
    "statusBarItem.prominentBackground": "#f0a84a",
    "statusBarItem.prominentForeground": "#2a1608",

    // Notifications / menus
    "notifications.background": "#1a1c2c",
    "notifications.border": "#e0283a",
    "notificationCenterHeader.background": "#22243a",
    "menu.background": "#1a1c2c",
    "menu.foreground": "#f1e2bd",
    "menu.selectionBackground": "#f0a84a",
    "menu.selectionForeground": "#2a1608",
