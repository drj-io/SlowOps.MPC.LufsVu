    "focusBorder": "#ff3b4e",
    "selection.background": "#f0a84a66",
    "widget.shadow": "#00000099",
    "icon.foreground": "#e3b265",
    "sash.hoverBorder": "#ff3b4e",
    "textLink.foreground": "#ffb347",
    "textLink.activeForeground": "#ffd27f",

    // Title bar (top header strip)
    "titleBar.activeBackground": "#1d1f2c",
    "titleBar.activeForeground": "#f3e6c8",
    "titleBar.inactiveBackground": "#171925",
    "titleBar.inactiveForeground": "#8a8578",
    "titleBar.border": "#ff3b4e55",
    "commandCenter.background": "#24263a",
    "commandCenter.foreground": "#f3e6c8",
    "commandCenter.border": "#e0283a",
    "commandCenter.activeBorder": "#ff3b4e",

    // Activity bar (walnut cabinet)
    "activityBar.background": "#3a1a10",
    "activityBar.foreground": "#ffc46b",
    "activityBar.inactiveForeground": "#b98a5a",
    "activityBar.border": "#c9853a66",
    "activityBar.activeBorder": "#ffb347",
    "activityBar.activeBackground": "#4f2416",
    "activityBarBadge.background": "#e0283a",
    "activityBarBadge.foreground": "#ffffff",

    // Side bar
